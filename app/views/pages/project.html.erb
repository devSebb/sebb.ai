<%# Project Detail — Case Study Layout %>
<% theme_color = @project[:theme_color] || "#0ED762" %>
<% theme_bg = @project[:theme_bg] || "#0A0A0A" %>

<div data-animate="project-detail">
  <%# 1. Hero — full-viewport, themed background %>
  <section class="section-room relative min-h-screen flex items-end pb-16 md:pb-24 overflow-hidden project-hero"
           style="background-color: <%= theme_bg %>;">
    <%# Hero image with parallax %>
    <div class="absolute inset-0">
      <%= image_tag @project[:hero_image],
          alt: @project[:name],
          class: "w-full h-full object-cover opacity-40 project-hero-img",
          loading: "eager" %>
      <div class="absolute inset-0 bg-gradient-to-t from-surface-black/90 via-surface-black/40 to-transparent project-hero-overlay"></div>
    </div>

    <div class="relative z-10 w-full">
      <span class="meta-label mb-6 block" style="color: <%= theme_color %>;">
        <%= @project[:year] %> &mdash; <%= @project[:role] %>
      </span>
      <h1 class="font-display font-extrabold text-display-xl text-surface-light project-detail-title">
        <%= @project[:name] %>
      </h1>
    </div>
  </section>

  <%# 2. Metadata bar — Role, Year, Stack, Type, Status (space-between, horizontal) %>
  <% status_label = (@project[:status].to_s == "live") ? "Live" : "In progress" %>
  <% pill_live = @project[:status].to_s == "live" %>
  <% has_link = @project[:link].to_s.strip.present? %>
  <section class="section-room py-8 border-t border-b border-border project-metadata">
    <div class="flex flex-wrap justify-between items-start gap-6">
      <div class="project-meta-col">
        <span class="meta-label block mb-2">Role</span>
        <span class="text-body text-surface-light"><%= @project[:role] %></span>
      </div>
      <div class="project-meta-col">
        <span class="meta-label block mb-2">Year</span>
        <span class="text-body text-surface-light"><%= @project[:year] %></span>
      </div>
      <div class="project-meta-col">
        <span class="meta-label block mb-2">Stack</span>
        <span class="text-body text-surface-light">
          <%= @project[:technologies].map { |t| t.to_s.capitalize }.join(", ") %>
        </span>
      </div>
      <div class="project-meta-col">
        <span class="meta-label block mb-2">Type</span>
        <span class="text-body text-surface-light"><%= @project[:tagline] %></span>
      </div>
      <div class="project-meta-col flex flex-col items-start">
        <span class="meta-label block mb-2">Status</span>
        <% if has_link %>
          <%= link_to @project[:link], target: "_blank", rel: "noopener noreferrer", class: "inline-flex flex-col items-start cursor-pointer no-underline", style: "color: inherit;" do %>
            <span class="rounded-full px-3 py-1 text-meta font-mono uppercase tracking-widest <%= pill_live ? 'bg-accent text-surface-black' : 'border border-accent/60 text-accent bg-accent/10' %>">
              <%= status_label %>
            </span>
            <% if @project[:domain].to_s.strip.present? %>
              <span class="text-meta-sm text-muted mt-1.5"><%= @project[:domain] %></span>
            <% end %>
          <% end %>
        <% else %>
          <span class="inline-flex flex-col items-start cursor-default">
            <span class="rounded-full px-3 py-1 text-meta font-mono uppercase tracking-widest <%= pill_live ? 'bg-accent text-surface-black' : 'border border-accent/60 text-accent bg-accent/10' %>">
              <%= status_label %>
            </span>
            <% if @project[:domain].to_s.strip.present? %>
              <span class="text-meta-sm text-muted mt-1.5"><%= @project[:domain] %></span>
            <% end %>
          </span>
        <% end %>
      </div>
    </div>
  </section>

  <%# 3. Description (main + additional paragraphs) %>
  <section class="section-room py-24 md:py-32">
    <div class="max-w-3xl mx-auto">
      <p class="text-body-lg text-muted leading-relaxed project-description">
        <%= @project[:detailed_description] %>
      </p>
      <% if @project[:additional_paragraphs].is_a?(Array) && @project[:additional_paragraphs].any? %>
        <% @project[:additional_paragraphs].each do |paragraph| %>
          <p class="text-body-lg text-muted leading-relaxed mt-6 project-description">
            <%= paragraph %>
          </p>
        <% end %>
      <% end %>
    </div>
  </section>

  <%# 4. Features %>
  <section class="section-room py-16 md:py-24">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      <div class="md:col-span-3">
        <span class="meta-label">Key Features</span>
      </div>
      <div class="md:col-span-9">
        <% @project[:features].each_with_index do |feature, index| %>
          <div class="project-feature flex gap-6 py-6 <%= 'border-t border-border' unless index == 0 %>">
            <span class="font-mono text-meta" style="color: <%= theme_color %>;"><%= "%02d" % (index + 1) %></span>
            <span class="text-body-lg text-surface-light"><%= feature %></span>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <%# 5. Gallery — Cinematic Horizontal Scroll %>
  <% if @project[:gallery]&.any? %>
    <section class="gallery-strip py-16 md:py-24"
             style="--gallery-theme-color: <%= theme_color %>;">
      <%# Gallery header %>
      <div class="section-room flex items-baseline justify-between mb-8">
        <span class="meta-label">Gallery</span>
        <span class="meta-label gallery-counter" data-gallery-counter>
          01 / <%= "%02d" % @project[:gallery].length %>
        </span>
      </div>

      <%# Horizontal scroll track with edge fade masks %>
      <div class="gallery-viewport" data-gallery-viewport data-cursor-text="Drag" aria-label="Project image gallery">
        <div class="gallery-track flex items-center gap-8 md:gap-12" data-gallery-track
             style="padding-left: clamp(1.5rem, 4vw, 6rem); padding-right: clamp(1.5rem, 4vw, 6rem);">
          <% @project[:gallery].each_with_index do |img, index| %>
            <div class="gallery-slide flex-shrink-0"
                 data-gallery-slide="<%= index %>">
              <div class="gallery-frame rounded-xl overflow-hidden"
                   style="height: 70vh; max-height: 600px;">
                <%= image_tag img,
                    alt: "#{@project[:name]} — #{index + 1}",
                    class: "gallery-img h-full w-auto block",
                    loading: index < 2 ? "eager" : "lazy",
                    decoding: "async",
                    style: "min-width: 280px; max-width: none; user-select: none; -webkit-user-drag: none;" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <%# Progress bar %>
      <div class="section-room mt-6">
        <div class="w-full h-[2px] bg-border rounded-full overflow-hidden">
          <div class="gallery-progress h-full rounded-full transition-none"
               data-gallery-progress
               style="width: 0%; background-color: var(--gallery-theme-color);">
          </div>
        </div>
      </div>
    </section>
  <% end %>

  <%# 6. Prev / Next navigation %>
  <section class="section-room py-24 md:py-32 border-t border-border">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <% if @adjacent[:prev] %>
        <%= link_to project_path(@adjacent[:prev][:slug]),
              class: "group project-nav-link" do %>
          <span class="meta-label block mb-4">Previous</span>
          <h3 class="font-display font-extrabold text-display-md text-muted group-hover:text-surface-light transition-colors duration-300">
            <%= @adjacent[:prev][:name] %>
          </h3>
        <% end %>
      <% end %>

      <% if @adjacent[:next] %>
        <%= link_to project_path(@adjacent[:next][:slug]),
              class: "group text-right project-nav-link" do %>
          <span class="meta-label block mb-4">Next</span>
          <h3 class="font-display font-extrabold text-display-md text-muted group-hover:text-surface-light transition-colors duration-300">
            <%= @adjacent[:next][:name] %>
          </h3>
        <% end %>
      <% end %>
    </div>
  </section>
</div>
