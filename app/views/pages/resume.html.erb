<!-- Resume Page -->
<div class="px-32 py-8 text-white font-sans" data-animate="resume">
  <!-- Header -->
  <div class="relative text-center my-10">
    <%= link_to root_path, class: "absolute left-0 top-1/2 -translate-y-1/2 text-gray-100 hover:text-white" do %>
      <%= image_tag "icons/back_arrow.svg", class: "w-8 h-8" %>
    <% end %>
    <h1 class="text-4xl font-bold"><%= @identity[:name] %></h1>
  </div>

  <!-- Contact Information -->
  <%# <div class="flex flex-col items-center mb-8">
    <p class="text-lg">Email: <a href="mailto:burke.sebastian1@gmail.com" class="text-gray-400 hover:underline">your.email@example.com</a></p>
    <p class="text-lg">LinkedIn: <a href="https://www.linkedin.com/in/sebastian-burke/" class="text-blue-400 hover:underline">www.linkedin.com/in/sebastian-burke/</a></p>
    <p class="text-lg">GitHub: <a href="https://github.com/devSebb" class="text-blue-400 hover:underline">github.com/devSebb</a></p>
  </div> %>

  <!-- Experience Section -->
  <div class="my-8">
    <h2 class="text-2xl font-semibold border-b border-gray-700 pb-2 mb-4">Experience</h2>
    <% @resume[:experience].each do |item| %>
      <div class="mb-6" data-animate-item="resume-timeline">
        <h3 class="text-xl font-semibold"><%= item[:title] %></h3>
        <p class="text-gray-400 italic"><%= item[:date_label] %></p>
        <ul class="list-disc list-inside mt-2 text-lg text-gray-200">
          <% item[:bullets].each do |bullet| %>
            <li><%= bullet %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>

  <!-- Education Section -->
  <div class="mb-8">
    <h2 class="text-2xl font-semibold border-b border-gray-700 pb-2 mb-4">Education</h2>
    <% @resume[:education].each do |item| %>
      <div class="mb-6">
        <h3 class="text-xl font-semibold"><%= item[:title] %></h3>
        <% if item[:subtitle].present? %>
          <p class="text-gray-400 italic"><%= item[:subtitle] %></p>
        <% end %>
        <p class="text-gray-400 italic"><%= item[:date_label] %></p>
        <% if item[:bullets].present? %>
          <ul class="list-disc list-inside mt-2 text-lg text-gray-200">
            <% item[:bullets].each do |bullet| %>
              <li><%= bullet %></li>
            <% end %>
          </ul>
        <% end %>
        <% if item[:details].present? %>
          <% item[:details].each do |detail| %>
            <p class="text-lg"><%= detail %></p>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Certifications Section -->
<div class="mb-8">
  <h2 class="text-2xl font-semibold border-b border-gray-700 pb-2 mb-4">Certifications</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <% @resume[:certifications].each do |item| %>
      <div class="bg-gray-800 rounded-lg p-4">
        <h3 class="text-xl font-semibold"><%= item[:title] %></h3>
        <p class="text-gray-400"><%= item[:provider] %></p>
        <p class="text-sm text-gray-500"><%= item[:date_label] %></p>
        <p class="text-sm text-gray-500">Credential ID <%= item[:credential_id] %></p>
      </div>
    <% end %>
  </div>
</div>

  <!-- Skills Section -->
 <div class="mb-8">
  <h2 class="text-2xl font-semibold border-b border-gray-700 pb-2 mb-6">Skills</h2>

  <!-- Technical Skills -->
  <h3 class="text-xl font-semibold mb-4">Technical Skills</h3>
  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 mb-8">
    <% @resume[:technical_skills].each do |skill| %>
      <div class="bg-gray-800 rounded-lg shadow-lg p-4 flex items-center justify-center">
        <span class="text-white text-lg"><%= skill %></span>
      </div>
    <% end %>
  </div>

  <!-- Additional Skills -->
  <h3 class="text-2xl font-semibold mb-6 text-center">Additional Skills</h3>
    <div class="flex justify-center">
      <div class="bg-gray-800 bg-opacity-50 p-8 rounded-lg shadow-lg w-full md:w-2/3 hover:shadow-xl transition duration-300">
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-lg text-gray-200">
          <% @resume[:additional_skills].each do |skill| %>
            <li><%= skill %></li>
          <% end %>
        </ul>
      </div>
    </div>
</div>


  <!-- Footer -->
  <div class="text-center text-gray-500 text-sm mt-8">
    <p>© <%= @identity[:footer_copyright_year] %> <%= @identity[:name] %>. All rights reserved.</p>
  </div>
</div>
