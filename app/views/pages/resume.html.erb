<%# Resume Page — Editorial grid layout %>
<div data-animate="resume">
  <%# Header %>
  <section class="section-room py-24 md:py-32">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-8">
      <div>
        <span class="meta-label block mb-6">Resume</span>
        <h1 class="font-display font-extrabold text-display-xl text-surface-light resume-title">
          <%= @identity[:name] %>
        </h1>
      </div>
      <a href="#" class="btn-magnetic self-start md:self-auto" data-magnetic>
        Download PDF
      </a>
    </div>
  </section>

  <%# Experience %>
  <section class="section-room py-16 md:py-24 border-t border-border">
    <span class="meta-label block mb-12">Experience</span>
    <div class="space-y-0">
      <% @resume[:experience].each_with_index do |item, index| %>
        <div class="resume-item grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 py-10 <%= 'border-t border-border' unless index == 0 %>">
          <div class="md:col-span-3">
            <span class="meta-label"><%= item[:date_label] %></span>
          </div>
          <div class="md:col-span-9">
            <h3 class="font-display font-bold text-display-md text-surface-light mb-4"><%= item[:title] %></h3>
            <ul class="space-y-2">
              <% item[:bullets].each do |bullet| %>
                <li class="text-body text-muted leading-relaxed flex gap-3">
                  <span class="text-accent mt-2 flex-shrink-0">&#8226;</span>
                  <span><%= bullet %></span>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <%# Education %>
  <section class="section-room py-16 md:py-24 border-t border-border">
    <span class="meta-label block mb-12">Education</span>
    <div class="space-y-0">
      <% @resume[:education].each_with_index do |item, index| %>
        <div class="resume-item grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 py-10 <%= 'border-t border-border' unless index == 0 %>">
          <div class="md:col-span-3">
            <span class="meta-label"><%= item[:date_label] %></span>
          </div>
          <div class="md:col-span-9">
            <h3 class="font-display font-bold text-display-md text-surface-light mb-2"><%= item[:title] %></h3>
            <% if item[:subtitle] %>
              <p class="text-body text-muted mb-4"><%= item[:subtitle] %></p>
            <% end %>
            <% if item[:bullets] %>
              <ul class="space-y-2">
                <% item[:bullets].each do |bullet| %>
                  <li class="text-body text-muted leading-relaxed flex gap-3">
                    <span class="text-accent mt-2 flex-shrink-0">&#8226;</span>
                    <span><%= bullet %></span>
                  </li>
                <% end %>
              </ul>
            <% end %>
            <% if item[:details] %>
              <% item[:details].each do |detail| %>
                <p class="text-body text-muted mt-2"><%= detail %></p>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <%# Certifications %>
  <section class="section-room py-16 md:py-24 border-t border-border">
    <span class="meta-label block mb-12">Certifications</span>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <% @resume[:certifications].each do |item| %>
        <div class="resume-item bg-surface-dark rounded-lg p-6">
          <h3 class="font-display font-bold text-body-lg text-surface-light mb-2"><%= item[:title] %></h3>
          <span class="meta-label block"><%= item[:provider] %></span>
          <span class="meta-label block mt-1"><%= item[:date_label] %></span>
        </div>
      <% end %>
    </div>
  </section>

  <%# Skills %>
  <section class="section-room py-16 md:py-24 border-t border-border">
    <span class="meta-label block mb-12">Skills</span>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <div>
        <h3 class="font-display font-bold text-display-md text-surface-light mb-6">Technical</h3>
        <div class="flex flex-wrap gap-3">
          <% @resume[:technical_skills].each do |skill| %>
            <span class="resume-item px-4 py-2 bg-surface-dark rounded text-body text-surface-light"><%= skill %></span>
          <% end %>
        </div>
      </div>
      <div>
        <h3 class="font-display font-bold text-display-md text-surface-light mb-6">Additional</h3>
        <ul class="space-y-3">
          <% @resume[:additional_skills].each do |skill| %>
            <li class="resume-item text-body text-muted flex gap-3">
              <span class="text-accent flex-shrink-0">&#8226;</span>
              <span><%= skill %></span>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </section>

  <%# Footer %>
  <section class="section-room py-8 border-t border-border">
    <div class="flex items-center justify-between">
      <span class="meta-label">&copy; <%= @identity[:footer_copyright_year] %> <%= @identity[:name] %></span>
      <span class="meta-label">Built with Rails, GSAP & too much coffee</span>
    </div>
  </section>
</div>
