<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "devSebb — Developer & Designer" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="devSebb — Software Developer & Designer. I design and build digital products that feel alive.">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <%= favicon_link_tag 'devSebb_logo.svg', type: 'image/svg+xml' %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Google Fonts: Syne (display) + Instrument Sans (body) + IBM Plex Mono (labels) %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Instrument+Sans:wght@400;500;600;700&family=Syne:wght@400;600;700;800&display=swap" rel="stylesheet">

    <%# GSAP + Plugins (CDN) %>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/ScrollTrigger.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/TextPlugin.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/Flip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/Observer.min.js"></script>

    <%# Lenis smooth scroll %>
    <script src="https://unpkg.com/lenis@1.1.13/dist/lenis.min.js"></script>

    <%# GSAP initialization — runs before importmap modules %>
    <script>
      function initializeGSAPGlobals() {
        if (typeof gsap !== 'undefined') {
          gsap.registerPlugin(ScrollTrigger, TextPlugin, Flip, Observer);
          window.GSAP_READY = true;
          window.dispatchEvent(new CustomEvent('gsapReady'));
          window.dispatchEvent(new CustomEvent('gsapInitialized'));
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializeGSAPGlobals);
      } else {
        initializeGSAPGlobals();
      }

      document.addEventListener('turbo:load', initializeGSAPGlobals);
    </script>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

    <%# JavaScript via importmap %>
    <%= javascript_importmap_tags %>

    <script type="module">
      import "application"
    </script>
  </head>

  <body class="bg-surface-black">
    <%# Custom Cursor (hidden on touch devices via CSS) %>
    <div class="cursor-dot hidden md:block" data-cursor="dot"></div>
    <div class="cursor-ring hidden md:block" data-cursor="ring"></div>
    <div class="cursor-particle hidden md:block" data-cursor-particle></div>
    <div class="cursor-particle hidden md:block" data-cursor-particle></div>
    <div class="cursor-particle hidden md:block" data-cursor-particle></div>

    <%# Preloader (initial load only) %>
    <div class="preloader" id="preloader" data-preloader>
      <span class="font-display font-extrabold text-display-md text-accent" data-preloader-text>DS</span>
    </div>

    <%# Fixed Navigation %>
    <nav class="nav-fixed" data-nav>
      <a href="<%= root_path %>" class="font-display font-bold text-lg text-white hover-underline" data-magnetic>
        devSebb
      </a>
      <button class="nav-menu-logo inline-flex items-center justify-center h-8 w-8 md:h-10 md:w-10 text-white transition-colors duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-surface-black" data-nav-toggle data-magnetic aria-label="Toggle menu">
        <%= render "shared/dev_sebb_logo" %>
      </button>
    </nav>

    <%# Menu Overlay %>
    <div class="menu-overlay" data-menu-overlay>
      <div class="flex flex-col items-center gap-8">
        <a href="<%= root_path %>" class="font-display font-extrabold text-display-md text-surface-light hover:text-accent transition-colors hover-underline" data-menu-link>Home</a>
        <a href="<%= root_path %>#projects" class="font-display font-extrabold text-display-md text-surface-light hover:text-accent transition-colors hover-underline" data-menu-link>Projects</a>
        <a href="<%= root_path %>#about" class="font-display font-extrabold text-display-md text-surface-light hover:text-accent transition-colors hover-underline" data-menu-link>About</a>
        <a href="<%= resume_path %>" class="font-display font-extrabold text-display-md text-surface-light hover:text-accent transition-colors hover-underline" data-menu-link>Resume</a>
        <a href="<%= root_path %>#contact" class="font-display font-extrabold text-display-md text-surface-light hover:text-accent transition-colors hover-underline" data-menu-link>Contact</a>

        <div class="flex gap-8 mt-12">
          <a href="https://github.com/devSebb" target="_blank" rel="noopener" class="meta-label hover:text-accent transition-colors" data-magnetic>GitHub</a>
          <a href="https://linkedin.com/in/sebastian-burke" target="_blank" rel="noopener" class="meta-label hover:text-accent transition-colors" data-magnetic>LinkedIn</a>
          <a href="https://x.com/dev_sebb" target="_blank" rel="noopener" class="meta-label hover:text-accent transition-colors" data-magnetic>X</a>
        </div>
      </div>
    </div>

    <%# Page Transition Overlay %>
    <div class="page-transition" data-page-transition></div>

    <%# Floating Geometry — persistent background depth layer %>
    <div class="fixed inset-0 pointer-events-none overflow-hidden" style="z-index: 1;" data-geometry-layer>
      <%# Thin accent circle %>
      <svg class="floating-geo" data-speed="0.2" data-cursor-weight="0.02" style="top: 15%; right: 10%; width: 200px; height: 200px;" viewBox="0 0 200 200" fill="none">
        <circle cx="100" cy="100" r="98" stroke="#0ED762" stroke-width="0.5" opacity="0.15"/>
      </svg>

      <%# Small dot cluster %>
      <svg class="floating-geo" data-speed="0.4" data-cursor-weight="0.015" style="bottom: 20%; left: 8%; width: 80px; height: 80px;" viewBox="0 0 80 80" fill="none">
        <circle cx="10" cy="10" r="2" fill="#0ED762" opacity="0.2"/>
        <circle cx="30" cy="15" r="1.5" fill="#0ED762" opacity="0.15"/>
        <circle cx="50" cy="8" r="2" fill="#0ED762" opacity="0.1"/>
        <circle cx="20" cy="40" r="1" fill="#0ED762" opacity="0.2"/>
        <circle cx="45" cy="35" r="2.5" fill="#0ED762" opacity="0.12"/>
        <circle cx="65" cy="45" r="1.5" fill="#0ED762" opacity="0.18"/>
        <circle cx="15" cy="65" r="2" fill="#0ED762" opacity="0.1"/>
        <circle cx="55" cy="70" r="1" fill="#0ED762" opacity="0.15"/>
      </svg>

      <%# Diagonal line %>
      <svg class="floating-geo" data-speed="0.3" data-cursor-weight="0.01" style="top: 40%; left: 50%; width: 300px; height: 2px;" viewBox="0 0 300 2" fill="none">
        <line x1="0" y1="1" x2="300" y2="1" stroke="#0ED762" stroke-width="0.5" opacity="0.1"/>
      </svg>

      <%# Small accent arc %>
      <svg class="floating-geo" data-speed="0.5" data-cursor-weight="0.025" style="top: 70%; right: 20%; width: 120px; height: 60px;" viewBox="0 0 120 60" fill="none">
        <path d="M10 50 Q60 -10 110 50" stroke="#0ED762" stroke-width="0.5" fill="none" opacity="0.12"/>
      </svg>
    </div>

    <%# Main Content %>
    <main class="relative" style="z-index: 2;">
      <%= yield %>
    </main>
  </body>
</html>
