<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "devSebb — Developer & Designer" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="devSebb — Software Developer & Designer. I design and build digital products that feel alive.">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <%= favicon_link_tag 'devSebb_logo.svg', type: 'image/svg+xml' %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Google Fonts: Syne (display) + Instrument Sans (body) + IBM Plex Mono (labels) %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Instrument+Sans:wght@400;500;600;700&family=Syne:wght@400..800&display=swap" rel="stylesheet">

    <%# GSAP + Plugins (CDN) %>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/ScrollTrigger.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/Observer.min.js"></script>

    <%# Lenis smooth scroll %>
    <script src="https://unpkg.com/lenis@1.1.13/dist/lenis.min.js"></script>

    <%# GSAP initialization — runs before importmap modules %>
    <script>
      function initializeGSAPGlobals() {
        if (typeof gsap !== 'undefined') {
          gsap.registerPlugin(ScrollTrigger, Observer);
          window.GSAP_READY = true;
          window.dispatchEvent(new CustomEvent('gsapReady'));
          window.dispatchEvent(new CustomEvent('gsapInitialized'));
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializeGSAPGlobals);
      } else {
        initializeGSAPGlobals();
      }

      document.addEventListener('turbo:load', initializeGSAPGlobals);
    </script>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

    <%# JavaScript via importmap %>
    <%= javascript_importmap_tags %>

    <script type="module">
      import "application"
    </script>
  </head>

  <body class="bg-surface-black">
    <%# Custom Cursor (hidden on touch devices via CSS) %>
    <div class="cursor-dot hidden md:block" data-cursor="dot"></div>
    <div class="cursor-ring hidden md:block" data-cursor="ring"></div>
    <div class="cursor-label hidden md:flex" data-cursor-label aria-hidden="true"></div>
    <div class="cursor-particle hidden md:block" data-cursor-particle></div>
    <div class="cursor-particle hidden md:block" data-cursor-particle></div>
    <div class="cursor-particle hidden md:block" data-cursor-particle></div>

    <%# Preloader — exhibition ticket (initial load only) %>
    <div class="preloader" id="preloader" data-preloader>
      <div class="flex flex-col items-center gap-5 text-center">
        <span class="font-display font-extrabold text-display-md text-surface-light" data-preloader-text>devSebb</span>
        <span class="meta-label" data-preloader-sub>A Working Exhibition</span>
        <span class="font-mono text-meta uppercase tracking-widest text-accent" data-preloader-counter>Nº 000</span>
      </div>
    </div>

    <%# Fixed Navigation %>
    <nav class="nav-fixed" data-nav>
      <a href="<%= root_path %>" class="font-display font-bold text-lg text-white hover-underline" data-magnetic>
        devSebb
      </a>
      <button class="nav-menu-logo inline-flex items-center justify-center h-10 w-10 md:h-14 md:w-14 text-white transition-colors duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-surface-black" data-nav-toggle data-magnetic aria-label="Toggle menu" aria-haspopup="dialog" aria-expanded="false" aria-controls="menu-overlay">
        <%= render "shared/dev_sebb_logo" %>
      </button>
    </nav>

    <%# Menu Overlay %>
    <div class="menu-overlay" id="menu-overlay" data-menu-overlay role="dialog" aria-modal="true" aria-label="Site menu" inert>
      <div class="flex flex-col items-center gap-8">
        <% [
          ["01", "Home",     root_path],
          ["02", "Projects", "#{root_path}#projects"],
          ["03", "About",    "#{root_path}#about"],
          ["04", "Resume",   resume_path],
          ["05", "Contact",  "#{root_path}#contact"]
        ].each do |index, name, path| %>
          <a href="<%= path %>" class="group flex items-baseline gap-4 font-display font-extrabold text-display-md text-white hover:text-accent transition-colors" data-menu-link>
            <span class="font-mono text-meta tracking-widest text-accent/60"><%= index %></span>
            <span class="menu-roll-mask">
              <span class="menu-roll">
                <span class="menu-roll-item"><%= name %></span>
                <span class="menu-roll-item" aria-hidden="true"><%= name %></span>
              </span>
            </span>
          </a>
        <% end %>

        <div class="flex gap-8 mt-12">
          <a href="https://github.com/devSebb" target="_blank" rel="noopener" class="meta-label hover:text-accent transition-colors" data-magnetic>GitHub</a>
          <a href="https://linkedin.com/in/sebastian-burke" target="_blank" rel="noopener" class="meta-label hover:text-accent transition-colors" data-magnetic>LinkedIn</a>
          <a href="https://x.com/dev_sebb" target="_blank" rel="noopener" class="meta-label hover:text-accent transition-colors" data-magnetic>X</a>
        </div>
      </div>
    </div>

    <%# Page Transition Overlay + destination room label %>
    <div class="page-transition" data-page-transition></div>
    <div class="page-transition-label" data-transition-label aria-hidden="true"></div>

    <%# Flash notifications %>
    <%= render "shared/flash" %>

    <%# Atmosphere — gallery lighting (aurora drift) behind the content %>
    <div class="atmosphere-layer" data-atmosphere aria-hidden="true">
      <div class="aurora-blob aurora-blob-a"></div>
      <div class="aurora-blob aurora-blob-b"></div>
    </div>

    <%# Cursor spotlight — the visitor holds the flashlight (desktop only) %>
    <div class="cursor-spotlight" data-spotlight aria-hidden="true"></div>

    <%# Film grain — fixed texture over everything %>
    <div class="grain-overlay" data-grain aria-hidden="true"></div>

    <%# Main Content %>
    <main class="relative" style="z-index: 2;">
      <%= yield %>
    </main>
  </body>
</html>
