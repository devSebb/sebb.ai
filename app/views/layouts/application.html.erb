<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Sebb Ai" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <%= favicon_link_tag 'ithinkicode.svg', type: 'image/svg+xml' %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">
    
    <!-- Load GSAP and plugins first -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/ScrollTrigger.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.0/TextPlugin.min.js"></script>
    <script src="https://unpkg.com/lenis@1.1.13/dist/lenis.min.js"></script>
    
    <!-- UPDATED: Turbo-aware GSAP initialization -->
    <script>
      function initializeGSAPGlobals() {
        if (typeof gsap !== 'undefined') {
          gsap.registerPlugin(ScrollTrigger, TextPlugin);
          window.GSAP_READY = true;
          window.dispatchEvent(new CustomEvent('gsapReady'));
          window.dispatchEvent(new CustomEvent('gsapInitialized'));
          console.log('GSAP globals initialized');
        }
      }
      
      // Initialize on first load
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializeGSAPGlobals);
      } else {
        initializeGSAPGlobals();
      }
      
      // Re-initialize on Turbo navigation
      document.addEventListener('turbo:load', initializeGSAPGlobals);
    </script>
    
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,100..900;1,100..900&family=Russo+One&display=swap" rel="stylesheet">
    
    <!-- Load JavaScript via importmap -->
    <%= javascript_importmap_tags %>
    
    <!-- Load application.js as a module -->
    <script type="module">
      import "application"
    </script>
  </head>

  <body>
    <%= yield %>
  </body>
</html>
