        <div><dt>Type</dt><dd>Client marketing site</dd></div>
        <div><dt>Audience</dt><dd>Brands, publishers, agencies</dd></div>
        <div><dt>Hosting</dt><dd>S3 and CloudFront, two environments</dd></div>
        <div><dt>Migration</dt><dd>2,935 legacy URLs audited</dd></div>
