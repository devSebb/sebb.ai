<div class="w-full h-screen rounded-xl border-2 border-gray-300 flex flex-col shadow-xl">
  <div class="flex flex-col h-full">
    <%# Top section with profile info %>
    <div class="flex flex-col py-5 items-center">
      <h1 class="font-bold text-2xl">SEBB</h1>
      <p class="font-bold text-gray-300">Software Developer</p>
      <%= image_tag "profile_pic.png", alt: "Profile picture", class: "w-44 h-44 rounded-full object-cover my-20" %>
    </div>

    <%# Spacer to push contact links to bottom %>
    <div class="flex-grow"></div>

    <%# Contact links section %>
    <div class="py-14">
      <div class="flex flex-col items-center">
        <div class="flex justify-between space-x-6">
          <%= link_to "https://github.com/devSebb", target: "_blank" do %>
            <%= image_tag "icons/github_icon.svg", class: "w-8 h-8 hover:scale-110 transition-all duration-300 ease-in-out" %>
          <% end %>
          <%= link_to "https://www.linkedin.com/in/sebastian-burke/", target: "_blank" do %>
            <%= image_tag "icons/linkedin_icon.svg", class: "w-8 h-8 hover:scale-110 transition-all duration-300 ease-in-out" %>
          <% end %>
          <%= link_to "https://x.com/dev_sebb", target: "_blank" do %>
            <%= image_tag "icons/x_icon.svg", class: "w-8 h-8 hover:scale-110 transition-all duration-300 ease-in-out" %>
          <% end %>
        </div>
        <div class="flex justify-between space-x-8 mt-10">
          <%= link_to "#contact", class: "px-3 py-2 text-center box-shadow bg-gray-600 rounded-lg text-white hover:scale-105 transition-all duration-300", data: { turbo: false } do %>
            Contact
          <% end %>
          <%= link_to resume_path, class: "px-3 py-2 text-center box-shadow bg-gray-600 rounded-lg text-white hover:scale-105 transition-all duration-300" do %>
            Resume
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
