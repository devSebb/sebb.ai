<%# Exhibition Room 6 — Contact / Guestbook %>
<section class="section-room flex flex-col pt-24 md:pt-32 pb-8 md:pb-10" id="contact" data-animate="contact">
  <div class="flex-grow grid grid-cols-1 md:grid-cols-2 gap-16 md:gap-12 content-start">
    <%# Left: heading + email + socials %>
    <div>
      <span class="meta-label mb-8 block"><span class="text-accent">05</span> — Contact</span>

      <h2 class="font-display font-extrabold text-[clamp(2.25rem,5vw,4.5rem)] leading-[0.95] tracking-[-0.02em] text-surface-light mb-8 contact-heading">
        <%= @contact_meta[:section_heading] %>
      </h2>

      <% if @contact_meta[:subheading] %>
        <p class="text-body-lg text-muted mb-12"><%= @contact_meta[:subheading] %></p>
      <% end %>

      <a href="mailto:<%= @contact_meta[:email_to] %>"
         class="font-mono text-accent text-body-lg hover-underline contact-email inline-block mb-12"
         data-magnetic>
        <%= @contact_meta[:email_to] %>
      </a>

      <div class="flex gap-8 contact-social">
        <a href="<%= @links[:github] %>" target="_blank" rel="noopener" class="meta-label hover:text-accent transition-colors" data-magnetic>GitHub</a>
        <a href="<%= @links[:linkedin] %>" target="_blank" rel="noopener" class="meta-label hover:text-accent transition-colors" data-magnetic>LinkedIn</a>
        <a href="<%= @links[:x] %>" target="_blank" rel="noopener" class="meta-label hover:text-accent transition-colors" data-magnetic>X</a>
      </div>
    </div>

    <%# Right: contact form %>
    <div class="contact-form">
      <%= form_for :contact, url: contact_path, local: true, html: { class: "space-y-8", data: { contact_form: true } } do |f| %>
        <div class="group">
          <label class="meta-label block mb-3 transition-colors duration-300 group-focus-within:text-accent">Name</label>
          <%= f.text_field :name, required: true,
              class: "w-full bg-transparent border-0 border-b border-border text-surface-light text-body py-3 focus:border-accent focus:ring-0 focus:outline-none transition-colors placeholder:text-muted",
              placeholder: "Your name" %>
        </div>

        <div class="group">
          <label class="meta-label block mb-3 transition-colors duration-300 group-focus-within:text-accent">Email</label>
          <%= f.email_field :email, required: true,
              class: "w-full bg-transparent border-0 border-b border-border text-surface-light text-body py-3 focus:border-accent focus:ring-0 focus:outline-none transition-colors placeholder:text-muted",
              placeholder: "your@email.com" %>
        </div>

        <div class="group">
          <label class="meta-label block mb-3 transition-colors duration-300 group-focus-within:text-accent">Message</label>
          <%= f.text_area :message, required: true, rows: 4,
              class: "w-full bg-transparent border-0 border-b border-border text-surface-light text-body py-3 focus:border-accent focus:ring-0 focus:outline-none transition-colors resize-none placeholder:text-muted",
              placeholder: "Tell me about your project..." %>
        </div>

        <%= f.submit "Send Message", class: "btn-magnetic cursor-pointer mt-4 disabled:opacity-60 disabled:cursor-wait", data: { magnetic: true, contact_submit: true } %>
      <% end %>
    </div>
  </div>

  <%# Footer — pinned to the bottom of the room by flex-grow above %>
  <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-4 mt-16 pt-8 border-t border-border contact-footer">
    <span class="meta-label">&copy; <%= @identity[:footer_copyright_year] %> <%= @identity[:name] %></span>
    <span class="meta-label flex items-center gap-2.5">
      <span class="availability-dot"></span>
      Open for work
    </span>
    <span class="meta-label">
      <%= @identity[:location_label].presence || "The real world" %> — <span data-local-time <%= tag.attributes("data-timezone": @identity[:timezone]) if @identity[:timezone].present? %>>--:--</span>
    </span>
    <span class="meta-label">Built with Rails, GSAP & too much mate</span>
  </div>
</section>
