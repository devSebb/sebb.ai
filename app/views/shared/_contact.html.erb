<%# Exhibition Room 6 — Contact / Guestbook %>
<section class="section-room py-24 md:py-32" id="contact" data-animate="contact">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-16 md:gap-12">
    <%# Left: heading + email + socials %>
    <div>
      <span class="meta-label mb-8 block">05 / Contact</span>

      <h2 class="font-display font-extrabold text-display-xl text-surface-light mb-8 contact-heading">
        <%= @contact_meta[:section_heading] %>
      </h2>

      <% if @contact_meta[:subheading] %>
        <p class="text-body-lg text-muted mb-12"><%= @contact_meta[:subheading] %></p>
      <% end %>

      <a href="mailto:<%= @contact_meta[:email_to] %>"
         class="font-mono text-accent text-body-lg hover-underline contact-email inline-block mb-12"
         data-magnetic>
        <%= @contact_meta[:email_to] %>
      </a>

      <div class="flex gap-8 contact-social">
        <a href="<%= @links[:github] %>" target="_blank" rel="noopener" class="meta-label hover:text-accent transition-colors" data-magnetic>GitHub</a>
        <a href="<%= @links[:linkedin] %>" target="_blank" rel="noopener" class="meta-label hover:text-accent transition-colors" data-magnetic>LinkedIn</a>
        <a href="<%= @links[:x] %>" target="_blank" rel="noopener" class="meta-label hover:text-accent transition-colors" data-magnetic>X</a>
      </div>
    </div>

    <%# Right: contact form %>
    <div class="contact-form">
      <%= form_for :contact, url: contact_path, local: true, html: { class: "space-y-8" } do |f| %>
        <div>
          <label class="meta-label block mb-3">Name</label>
          <%= f.text_field :name, required: true,
              class: "w-full bg-transparent border-0 border-b border-border text-surface-light text-body py-3 focus:border-accent focus:ring-0 focus:outline-none transition-colors placeholder:text-muted/40",
              placeholder: "Your name" %>
        </div>

        <div>
          <label class="meta-label block mb-3">Email</label>
          <%= f.email_field :email, required: true,
              class: "w-full bg-transparent border-0 border-b border-border text-surface-light text-body py-3 focus:border-accent focus:ring-0 focus:outline-none transition-colors placeholder:text-muted/40",
              placeholder: "your@email.com" %>
        </div>

        <div>
          <label class="meta-label block mb-3">Message</label>
          <%= f.text_area :message, required: true, rows: 4,
              class: "w-full bg-transparent border-0 border-b border-border text-surface-light text-body py-3 focus:border-accent focus:ring-0 focus:outline-none transition-colors resize-none placeholder:text-muted/40",
              placeholder: "Tell me about your project..." %>
        </div>

        <%= f.submit "Send Message", class: "btn-magnetic cursor-pointer mt-4", data: { magnetic: true } %>
      <% end %>
    </div>
  </div>

  <%# Footer %>
  <div class="flex items-center justify-between mt-24 pt-8 border-t border-border contact-footer">
    <span class="meta-label">&copy; <%= @identity[:footer_copyright_year] %> <%= @identity[:name] %></span>
    <span class="meta-label">Built with Rails, GSAP & too much coffee</span>
  </div>
</section>
