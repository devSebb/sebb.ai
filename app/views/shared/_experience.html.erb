<div id="experience-container" class="" data-animate="experience">
  <h1 class="text-3xl font-bold mb-6">Experience</h1>

  <ol class="relative border-s border-gray-200 dark:border-gray-700">
    <% @experience.each do |item| %>
      <li class="mb-10 ms-4">
        <div class="experience-dot absolute w-3 h-3 bg-gray-200 rounded-full mt-1.5 -start-1.5 border border-white" data-animate-dot="experience"></div>
        <time class="mb-1 text-sm font-normal leading-none text-gray-400 "><%= item[:date_label] %></time>
        <h3 class="text-lg font-semibold text-gray-1"><%= item[:title] %></h3>
        <p class="mb-4 text-base font-normal text-zinc-200"><%= item[:summary] %></p>
      </li>
    <% end %>
  </ol>
</div>
