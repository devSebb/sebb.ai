<%# Exhibition Room 3 — Central Gallery Hall %>
<section class="section-room py-24 md:py-32" id="projects" data-animate="projects">
  <div class="flex items-baseline justify-between mb-16">
    <span class="meta-label"><span class="text-accent">02</span> — Projects</span>
    <span class="meta-label"><%= @projects.length %> Selected Works</span>
  </div>

  <%# Project list — hover-reveal pattern %>
  <div class="projects-list relative">
    <% @projects.each_with_index do |project, index| %>
      <%= link_to project_path(project[:slug]),
            class: "project-row group block border-t border-border py-8 md:py-10 transition-colors duration-300 hover:border-accent hover:bg-surface-dark/40",
            data: {
              project_image: image_path(project[:hero_image]),
              project_slug: project[:slug],
              cursor_text: "View"
            } do %>
        <div class="grid grid-cols-12 items-center gap-4 transition-transform duration-motion-normal ease-expo-out md:group-hover:translate-x-3">
          <%# Catalogue number %>
          <span class="meta-label col-span-1 whitespace-nowrap project-number">
            <span class="hidden md:inline">Nº </span><%= "%03d" % (index + 1) %>
          </span>

          <%# Name %>
          <h3 class="col-span-5 md:col-span-6 font-display font-extrabold text-display-md text-surface-light opacity-20 group-hover:opacity-100 transition-opacity duration-300 project-name">
            <%= project[:name] %>
          </h3>

          <%# Tagline %>
          <span class="meta-label col-span-4 md:col-span-3 text-right hidden md:block project-tagline">
            <%= project[:tagline] %>
          </span>

          <%# Year %>
          <span class="meta-label col-span-2 text-right project-year">
            <%= project[:year] %>
          </span>
        </div>
      <% end %>
    <% end %>

    <%# Bottom border %>
    <div class="border-t border-border"></div>
  </div>

  <%# Floating cursor-follow image (desktop only) — framed like a hung work %>
  <div class="project-float-img fixed top-0 left-0 w-[400px] h-[280px] pointer-events-none opacity-0 z-30 overflow-hidden rounded-lg hidden md:block border border-accent/60"
       style="will-change: transform;">
    <img src="" alt="" class="w-full h-full object-cover" data-project-float-src />
    <span class="absolute bottom-2 left-2 meta-label text-surface-light bg-surface-black/70 px-2 py-1 rounded" data-project-float-caption></span>
  </div>
</section>
