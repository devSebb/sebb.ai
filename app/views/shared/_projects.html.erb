<div data-animate="projects">
      <h2 class="text-3xl font-bold mb-8" data-animate-title="projects">Projects</h2>
      <div class="grid grid-cols-2 gap-6 z-20" id="projects-container">
        <% @projects.each_with_index do |project, index| %>
          <div class="relative rounded-lg group overflow-hidden shadow-lg hover:shadow-xl transition-all project-item z-20" data-index="<%= index %>" data-animate-item="project">
            <%= image_tag "projects/#{project[:image]}", alt: project[:name], class: "w-full h-64 object-cover transition-transform duration-00 ease-in-out group-hover:scale-105 hover:opacity-100", data: { animate_image: "project" } %>
            <div class="absolute inset-0 flex flex-col items-center justify-center bg-gray-900/80 opacity-0 group-hover:opacity-100 transition-all duration-300 ease-in-out" data-animate-overlay="project">
              <%= link_to project[:url], target: "_blank", class: "text-white text-2xl font-bold mb-2 hover:text-primary transition-colors duration-200" do %>
                <%= project[:name] %> <i class="fas fa-external-link-alt text-sm ml-1"></i>
              <% end %>
              <p class="text-white text-md text-center px-6 mb-4"><%= project[:description] %></p>
              <%= link_to "See More", project_path(project[:slug]), class: "px-6 py-2.5 bg-primary text-white rounded-lg hover:bg-secondary transition-colors duration-200 font-semibold" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
