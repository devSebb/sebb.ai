<%# Exhibition Room 4 — Skills Display Wall %>
<section class="section-room py-24 md:py-32" id="skills" data-animate="skills">
  <div class="flex items-baseline justify-between mb-16">
    <span class="meta-label"><span class="text-accent">03</span> — Skills</span>
    <span class="meta-label hidden sm:block">Full-stack — design to deployment</span>
  </div>

  <p class="text-muted text-body mb-12 max-w-xl">
    From database to UI, strategy to shipping — here's the stack that makes it happen.
  </p>

  <%# 4-column skill categories grid %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12 md:gap-8">
    <% @skills_categories.each do |category| %>
      <div class="skill-category">
        <h3 class="font-display font-semibold text-display-sm text-surface-light mb-2 skill-cat-heading">
          <%= category[:name] %>
        </h3>
        <span class="font-mono text-meta uppercase tracking-widest text-muted mt-1 mb-6 block">
          <%= category[:items].length.to_s.rjust(2, "0") %> <%= category[:name].downcase %>
        </span>
        <ul class="space-y-4">
          <% category[:items].each do |item| %>
            <li class="skill-item group flex items-center gap-3 text-muted hover:text-surface-light transition-colors duration-200 cursor-default">
              <span class="w-1.5 h-1.5 rounded-full bg-accent scale-0 group-hover:scale-100 transition-transform duration-200"></span>
              <span class="text-body"><%= item %></span>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>

  <%# ── The Toolwall — every instrument, catalogued and filterable ── %>
  <%
    tool_groups = @tech_stack
    all_tools = tool_groups.flat_map { |group| group[:items].map { |tool| tool.merge(group_id: group[:id]) } }
  %>
  <%= tech_logo_sprite(all_tools.map { |tool| tool[:logo] }) %>

  <div class="toolwall mt-24 md:mt-32 border-t border-border pt-12" data-toolwall>
    <div class="flex items-baseline justify-between gap-6 flex-wrap mb-8">
      <h3 class="font-display font-semibold text-display-sm text-surface-light">
        The Instruments
      </h3>
      <span class="meta-label">
        <%= all_tools.length %> Tools — <%= tool_groups.length %> Disciplines
      </span>
    </div>

    <%# Filter rail — the catalogue's index tabs %>
    <div class="flex flex-wrap gap-x-7 gap-y-3 mb-10" role="group" aria-label="Filter tools by discipline">
      <button type="button" class="toolwall-chip is-active" data-toolwall-filter="all" aria-pressed="true">
        All<span class="toolwall-chip-count"><%= all_tools.length %></span>
      </button>
      <% tool_groups.each do |group| %>
        <button type="button" class="toolwall-chip" data-toolwall-filter="<%= group[:id] %>" aria-pressed="false">
          <%= group[:name] %><span class="toolwall-chip-count"><%= group[:items].length %></span>
        </button>
      <% end %>
    </div>

    <%# Specimen lattice — shared hairlines, one cell per tool %>
    <div class="toolwall-grid" data-toolwall-grid>
      <% all_tools.each_with_index do |tool, index| %>
        <div class="toolwall-cell" data-toolwall-item data-group="<%= tool[:group_id] %>">
          <span class="toolwall-index"><%= "%02d" % (index + 1) %></span>
          <span class="toolwall-mark"><%= tech_logo(tool[:logo]) %></span>
          <span class="toolwall-name"><%= tool[:name] %></span>
        </div>
      <% end %>
    </div>
  </div>
</section>
