<%# Exhibition Room 4 — Skills Display Wall %>
<section class="section-room py-24 md:py-32" id="skills" data-animate="skills">
  <div class="flex items-baseline justify-between mb-16">
    <span class="meta-label">03 / Skills</span>
    <span class="meta-label">What I work with</span>
  </div>

  <%# 4-column skill categories grid %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12 md:gap-8">
    <% @skills_categories.each do |category| %>
      <div class="skill-category">
        <h3 class="font-display font-bold text-display-sm text-surface-light mb-8 skill-cat-heading">
          <%= category[:name] %>
        </h3>
        <ul class="space-y-4">
          <% category[:items].each do |item| %>
            <li class="skill-item group flex items-center gap-3 text-muted hover:text-surface-light transition-colors duration-200 cursor-default">
              <span class="w-1.5 h-1.5 rounded-full bg-accent scale-0 group-hover:scale-100 transition-transform duration-200"></span>
              <span class="text-body"><%= item %></span>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>

  <%# Marquee rows %>
  <div class="mt-24 overflow-hidden">
    <%# Row 1 — left scroll %>
    <div class="marquee-container mb-4">
      <div class="flex whitespace-nowrap marquee-track-left">
        <% 2.times do %>
          <% @tech_stack.each do |tech| %>
            <span class="inline-block font-mono text-meta uppercase tracking-widest text-border px-8 py-3"><%= tech[:name] %></span>
          <% end %>
        <% end %>
      </div>
    </div>
    <%# Row 2 — right scroll %>
    <div class="marquee-container">
      <div class="flex whitespace-nowrap marquee-track-right">
        <% 2.times do %>
          <% @tech_stack.reverse.each do |tech| %>
            <span class="inline-block font-mono text-meta uppercase tracking-widest text-border px-8 py-3"><%= tech[:name] %></span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</section>
