<%# Exhibition Room 1 — Museum Entrance Performance %>
<section class="section-room flex flex-col justify-between min-h-screen relative" id="hero" data-animate="hero">
  <%# Top: Museum wall label %>
  <div class="pt-28 md:pt-36">
    <span class="meta-label hero-meta"><%= @about[:hero_description] %></span>
  </div>

  <%# Center: Massive name with depth parallax layers %>
  <div class="flex-grow flex items-center relative">
    <%# Back layer — parallax depth %>
    <h1 class="heading-display hero-title-back absolute inset-0 flex items-center opacity-[0.08] select-none pointer-events-none" aria-hidden="true">
      <%= @identity[:name] %>
    </h1>
    <%# Front layer — primary %>
    <h1 class="heading-display hero-title-front relative" data-hero-title>
      <%= @identity[:name] %>
    </h1>
  </div>

  <%# Bottom row %>
  <div class="flex items-end justify-between pb-12 md:pb-16">
    <%# Tagline %>
    <p class="text-muted text-body-lg max-w-md hero-tagline">
      <%= @about[:hero_tagline] %>
    </p>

    <%# Scroll cue %>
    <div class="flex flex-col items-center gap-3 hero-scroll-cue">
      <span class="meta-label">Scroll</span>
      <div class="w-[1px] h-12 bg-accent animate-scroll-line"></div>
    </div>
  </div>
</section>
