<%# About — short on purpose %>
<section class="section-room py-24 md:py-32 !min-h-0" id="about" data-animate="about">
  <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-8">
    <div class="md:col-span-5">
      <span class="meta-label about-label"><span class="text-accent">03</span> — About</span>
      <h2 class="font-display font-extrabold text-display-md text-surface-light mt-6 about-heading"><%= @about[:heading] %></h2>

      <div class="group flex items-center gap-4 pt-10 about-profile">
        <%= image_tag "profile.JPG", alt: "Sebastian Burke", class: "w-20 h-20 rounded-full object-cover grayscale transition-all duration-500 group-hover:grayscale-0 group-hover:scale-105", loading: "lazy", width: 80, height: 80 %>
        <div>
          <span class="text-surface-light font-body font-medium">Sebastian Burke</span>
          <span class="meta-label block mt-1">devSebb · English / Spanish</span>
        </div>
      </div>
    </div>

    <div class="md:col-span-6 md:col-start-7 space-y-6">
      <% @about[:paragraphs].each_with_index do |paragraph, index| %>
        <p class="<%= index.zero? ? "text-[1.5rem] leading-snug text-surface-light" : "text-body-lg text-[#A3A3A0] leading-relaxed" %> about-paragraph">
          <%= paragraph %>
        </p>
      <% end %>
      <a href="#contact" class="btn-magnetic about-paragraph !mt-10" data-magnetic>Write to me</a>
    </div>
  </div>
</section>
