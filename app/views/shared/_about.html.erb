<%# Exhibition Room 2 — About %>
<section class="section-room py-24 md:py-32" id="about" data-animate="about">
  <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-8">
    <%# Left column: label + heading %>
    <div class="md:col-span-4">
      <span class="meta-label about-label"><span class="text-accent">01</span> — About</span>
      <h2 class="font-display font-extrabold text-display-md text-surface-light mt-6 about-heading">Building things that feel alive
      </h2>
    </div>

    <%# Right column: paragraphs %>
    <div class="md:col-span-7 md:col-start-6 space-y-6">
      <% @about[:paragraphs].each do |paragraph| %>
        <p class="text-body-lg text-muted leading-relaxed about-paragraph">
          <%= paragraph %>
        </p>
      <% end %>

      <%# Profile hint %>
      <div class="group flex items-center gap-4 pt-8 about-profile">
        <%= image_tag "profile.JPG", alt: @identity[:name], class: "w-16 h-16 rounded-full object-cover grayscale transition-all duration-500 group-hover:grayscale-0 group-hover:scale-105", loading: "lazy" %>
        <div>
          <span class="text-surface-light font-body font-medium"><%= @identity[:name] %></span>
          <span class="meta-label block mt-1">Developer & Designer</span>
        </div>
      </div>
    </div>
  </div>
</section>
