<div class="my-10 md:my-24" id="specializations-container" data-animate="specializations">
  <h1 class="text-3xl font-bold my-4 md:my-7 opacity-0" data-animate-title="specializations">What I Specialize in</h1>
  <div class="grid grid-cols-2 gap-5">
    <% @specializations.each do |item| %>
      <div id="<%= item[:id] %>" class="specialization-box section-card interactive-card p-4 box-shadow z-30" data-animate-item="specialization">
        <div class="flex justify-between items-center mb-2">
          <h2 class="text-xl font-bold mb-2 text-shadow"><%= item[:title] %></h2>
          <%= image_tag item[:icon], alt: item[:alt], class: "w-10 h-10 rounded-full" %>
        </div>
        <p class="text-md font-light"><%= item[:description] %></p>
      </div>
    <% end %>
  </div>
</div>
