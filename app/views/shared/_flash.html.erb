<%# Flash toasts — themed, dismissible, a11y-friendly. Renders nothing when empty. %>
<% visible_flash = flash.to_h.reject { |_type, message| message.blank? } %>
<% if visible_flash.any? %>
  <div class="fixed z-[90] top-24 right-gutter left-gutter sm:left-auto sm:w-full sm:max-w-sm flex flex-col gap-3 pointer-events-none"
       aria-label="Notifications">
    <% visible_flash.each do |type, message| %>
      <% style = flash_style(type) %>
      <div class="flash-toast pointer-events-auto relative flex items-start gap-4 overflow-hidden rounded-lg border border-border bg-surface-dark/95 backdrop-blur-sm py-4 pl-5 pr-4 shadow-2xl"
           data-controller="flash"
           data-flash-dismiss-after-value="6000"
           role="<%= style[:role] %>"
           aria-live="<%= style[:aria_live] %>">
        <span class="absolute inset-y-0 left-0 w-[3px]" style="background-color: <%= style[:accent] %>;" aria-hidden="true"></span>

        <div class="min-w-0 flex-1">
          <span class="meta-label block mb-1" style="color: <%= style[:accent] %>;"><%= style[:label] %></span>
          <p class="text-body text-surface-light leading-snug break-words"><%= message %></p>
        </div>

        <button type="button"
                class="shrink-0 -mr-1 -mt-1 h-8 w-8 inline-flex items-center justify-center text-muted hover:text-surface-light transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded"
                data-action="flash#close"
                aria-label="Dismiss notification">
          <svg viewBox="0 0 14 14" class="h-3.5 w-3.5" fill="none" aria-hidden="true">
            <path d="M1 1L13 13M13 1L1 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
    <% end %>
  </div>
<% end %>
